<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ScanPdf" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/emerald</item>
        <item name="colorOnSecondary">@color/on_emerald</item>
        <item name="colorSecondaryContainer">@color/emerald_dim</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/warn</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_alt</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ScanPdf.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.ScanPdf.BottomSheet</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorControlHighlight">@color/accent_dim</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.ScanPdf.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.ScanPdf.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.ScanPdf.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.ScanPdf.Large</item>
    </style>

    <style name="Shape.ScanPdf.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.ScanPdf.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.ScanPdf.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Shape.ScanPdf.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">26dp</item>
    </style>

    <style name="ThemeOverlay.ScanPdf.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_alt</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/Shape.ScanPdf.Large</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">86%</item>
    </style>

    <style name="ThemeOverlay.ScanPdf.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/surface_alt</item>
        <item name="bottomSheetStyle">@style/Widget.ScanPdf.BottomSheet</item>
    </style>

    <style name="Widget.ScanPdf.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/Shape.ScanPdf.Large</item>
        <item name="backgroundTint">@color/surface_alt</item>
    </style>

    <!-- ============================================================ text -->

    <style name="Text.ScanPdf.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.ScanPdf.Label" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.ScanPdf.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.ScanPdf.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ========================================================== widgets -->

    <style name="Widget.ScanPdf.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_alt</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardCornerRadius">22dp</item>
    </style>

    <style name="Widget.ScanPdf.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconTint">@color/on_accent</item>
    </style>

    <style name="Widget.ScanPdf.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/surface_high</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <style name="Widget.ScanPdf.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.ScanPdf.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">44dp</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipBackgroundColor">@color/surface_high</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">14dp</item>
        <item name="chipEndPadding">14dp</item>
    </style>

    <style name="Widget.ScanPdf.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/accent</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

</resources>
